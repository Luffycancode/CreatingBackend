<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>





    <div class="bg-white border-b">

        <div class="w-[500px] mx-auto flex justify-between items-center py-3">

            <a href="/toDoHome" class="font-semibold text-gray-700">
                Home
            </a>

            <a href="/completed" class="font-semibold text-gray-700">
                Completed Todo
            </a>



        </div>

    </div>





    <div class="w-[500px] mx-auto mt-10">

        <h2 class="text-2xl font-semibold mb-5">Completed list</h2>


        <div class="bg-white p-4 rounded">

            <h3 class="font-bold mb-3">Tasks</h3>

            <% for(let i=0; i<todos.length; i++) { %>

            <div class="flex justify-between items-center border-b py-2">
                <p><%= todos[i].title %></p>
                    <form action="/delete" method="post">
                        <input type="hidden" name="id" value="<%= todos[i]._id %>">
                        <input type="hidden" name="page" value="completed">
                        <button class="text-xs bg-red-500 text-white px-2 py-1 rounded">Delete</button>
                    </form>
            </div>

            <% } %>
        </div>

    </div>

</body>

</html>