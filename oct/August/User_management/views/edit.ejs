<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New_user</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    
    <div class="border-b py-3">

        <div class="flex justify-between max-w-7xl mx-auto">

                    <a href="/" class="text-3xl font-bold">User Management</a>
                    <a href="/add-user" class="text-2xl font-bold hover:text-blue-600 underline">Add User</a>

        </div>


    </div>



    <div class="py-3">
        <div class="flex flex-col justify-between mt-20 mb-2 items-center justify-center">
            <form action="/update" method="post">

                    <!-- <input type="text" name="name" id="name" required placeholder="Enter your name" class="border-2 flex flex-col m-5 w-full px-4 py-2 border-slate-400 rounded-lg text-slate-900"> -->
                    <!-- <input type="email" name="email" id="email" required placeholder="Enter your email" class="border-2 flex flex-col m-5 w-full px-4 py-2 border-slate-400 rounded-lg text-slate-900">  -->
                    <!-- <input type="text" name="image" id="image" required placeholder="Enter your image url" class="border-2 flex flex-col m-5 w-full px-4 py-2 border-slate-400 rounded-lg text-slate-900">   -->
                    
                    <input type="hidden" name="UserId" value="<%= userid %>">

                    <h2 class="flex flex-col m-4 w-full px-1 py-1 text-slate-900 text-2xl font-bold">
                        Hi <%=user.name%>. Update your profile details below.
                    </h2>

                    <input type="text" value="<%=user.name%>" name="name" id="name" required placeholder="Enter your name" class="border-2 flex flex-col m-5 w-full px-4 py-2 border-slate-400 rounded-lg text-slate-900">
                    <input type="email" value="<%=user.email%>" name="email" id="email" required placeholder="Enter your email" class="border-2 flex flex-col m-5 w-full px-4 py-2 border-slate-400 rounded-lg text-slate-900"> 
                    <input type="text" value="<%=user.image%>" name="image" id="image" required placeholder="Enter your image url" class="border-2 flex flex-col m-5 w-full px-4 py-2 border-slate-400 rounded-lg text-slate-900">  




                    <button type="submit" class="border-3 bg-amber-50 m-4 px-5 py-2 hover:bg-emerald-500 justify-center">Save</button>


            </form>
        </div>
    </div>
    

</body>
</html>