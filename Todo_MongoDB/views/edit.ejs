<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Todo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

    <div class="bg-white border-b">
        <div class="w-[500px] mx-auto flex justify-between items-center py-3">

            <a href="/toDoHome" class="font-semibold text-gray-700">
                Home
            </a>

            <form action="/completed" method="post">
                <button class="font-semibold text-gray-700">
                    Completed Items
                </button>
            </form>

        </div>
    </div>


    <div class="w-[500px] mx-auto mt-10">

        <h2 class="text-2xl font-semibold mb-5"> Edit Todo </h2>

        <form action="/edititem" method="post" class="flex gap-2 mb-6">

            <input type="text" name="edited" value="<%= data.title %>" class="border border-gray-300 px-3 py-2 rounded flex-1">

            <input type="hidden" name="id" value="<%= data._id %>">

            <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded">Edit</button>

            <a href="/toDoHome" class="bg-gray-400 text-white px-4 py-2 rounded">Cancel</a>

        </form>

    </div>

</body>

</html>