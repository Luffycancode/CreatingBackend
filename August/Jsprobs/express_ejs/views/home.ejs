<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>



<div class=" flex p-4 items-center justify-center mt-10">


<form action="/register" method="post">

<h1 class="text-2xl font-bold text-slate-800 text-center mb-6 tracking-tight mr-5">Please enter your name</h1>
<input type="text" name="name" id="name" placeholder="Enter your name" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 focus:bg-white transition-all duration-200 ml-2">

<button class="w-full py-3 px-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl shadow-lg shadow-indigo-100 hover:shadow-indigo-200 active:scale-[0.98] transition-all duration-200 ml-2 mt-2">Submit</button>




</form>

</div>


</body>
</html>