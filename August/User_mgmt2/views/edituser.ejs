<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Edit User</title>
</head>
<body class="bg-gray-50 p-4">
    
    <!-- Navigation / Toolbar -->
    <div class="flex items-center justify-between bg-white border border-slate-200 rounded-xl p-4 shadow-sm max-w-7xl mx-auto mt-8">
        <a href="/" class="text-xl font-bold text-slate-800 tracking-tight">User management</a>
        <a href="/newuser" class="inline-flex items-center justify-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg shadow-sm shadow-indigo-100 hover:shadow-md transition-all duration-150 active:scale-[0.98]">Add new user</a>
    </div>

    <!-- Form Container -->
    <div class="max-w-7xl mx-auto mt-10 px-4">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Edit User Details</h2>
        
        <!-- FIXED: Points to update route -->
        <form action="/updateuser" method="post" class="space-y-4">
            
            <!-- FIXED: Hidden input tracking the array position index -->
            <input type="hidden" name="userid" value="<%= userid %>">

            <!-- Name Input Field (Fixed with value attribute) -->
            <div>
                <input 
                    type="text" 
                    name="name" 
                    placeholder="Enter your name" 
                    value="<%= user.name %>" 
                    required
                    class="block w-full max-w-md px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500"
                >
            </div>

            <!-- Email Input Field (Fixed with value attribute) -->
            <div>
                <input 
                    type="email" 
                    name="email" 
                    placeholder="Enter Email" 
                    value="<%= user.email %>" 
                    required
                    class="block w-full max-w-md px-3 py-2 border border-gray-300 rounded-md shadow-sm text-sm focus:outline-none focus:ring-1 focus:ring-indigo-500 focus:border-indigo-500"
                >
            </div>

            <!-- Submit Button (Fixed Text Label) -->
            <div class="pt-2">
                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-md shadow-sm transition-colors">
                    Save Changes
                </button>
                <a href="/" class="ml-2 inline-block px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-100 transition-colors">
                    Cancel
                </a>
            </div>

        </form>
    </div>

</body>
</html>
