<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>users</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    


<div>


<% for(let i=0;i<users.length;i++){ %>
    <p>Name: <%= users[i].first_name %></p>
    <p>Age: <%= users[i].gender %></p>
<%}%>



</div>


</body>
</html>