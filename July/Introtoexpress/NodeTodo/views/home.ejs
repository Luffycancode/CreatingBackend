<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
 
<h1 class="text-3xl font-bold underline text-center mt-45">Add to-do</h1>

<form action="/Newitem" method="post">

<input type="text" name="item" id="" placeholder="Enter the item" class="text-3xl font-bold text-center mt-12 ml-137 border-4 border-black rounded-full px-6 py-3">
<button class="bg-black text-white px-5 py-4 mt-3 rounded-lg" type="submit">Add</button>

</form>

<div class="">
<% for(let i=0;i<tasks.length;i++){ %>
<div class="bg-gray-50 my-3 p-3 align-center">
    <%=tasks[i].title %>
 
</div>
<%}%>
</div>


</body>
</html>