<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Form</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    
<div class="align-center text-center mt-12 ">

<form action="/submit" method="post" >
    <h1 class="text-center align-center font-bold text-4xl">Enter the user details</h1>
    <div class="mt-25">

    <input type="text" name="FullName" id="" placeholder="Enter fullname" class="border-2 rounded-lg bg-gray-50 border-black px-4 py-2">
    <input type="text" name="Email" id="" placeholder=" Enter email" class="border-2 rounded-lg bg-gray-50 border-black px-4 py-2">
    <input type="text" name="Age" id="" placeholder="Enter age" class="border-2 rounded-lg bg-gray-50 border-black px-4 py-2">
    <input type="text" name="FavoriteColor" id="" placeholder="Enter Favcolour" class="border-2 rounded-lg bg-gray-50 border-black px-4 py-2">

    <button type="submit" class="border-4 border-black bg-black text-white font-bold ml-8 px-3 py-1">Submit</button>

    </div>
</form>

</div>


</body>
</html>